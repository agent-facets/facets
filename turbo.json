{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["bun.lock", "bunfig.toml", "package.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["$TURBO_ROOT$/test-results/**"]
    },
    "types": {
      "dependsOn": []
    },
    "check": {
      "dependsOn": [
        "//#lint",
        "types",
        "test",
        "//#types",
        "//#test:scripts",
        "//#docs:validate",
        "//#docs:broken-links",
        "//#ci:check-pack"
      ]
    },
    "//#ci:check-pack": {
      "inputs": [".circleci/src/**", ".circleci/release-src/**", ".circleci/config.yml", ".circleci/release.yml"]
    },
    "//#test:scripts": {
      "inputs": ["scripts/**"]
    },
    "//#types": {
      "inputs": ["$TURBO_DEFAULT$", "!$TURBO_ROOT$/.changeset/**"]
    },
    "//#lint": {
      "inputs": ["$TURBO_DEFAULT$", "!$TURBO_ROOT$/.changeset/**"]
    },
    "//#docs:validate": {
      "inputs": ["docs/**"]
    },
    "//#docs:broken-links": {
      "inputs": ["docs/**"]
    }
  },
  "ui": "tui"
}
