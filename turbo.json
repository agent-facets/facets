{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["bun.lock", "mise.toml"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx"]
    },
    "build": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.e2e.test.ts", "$TURBO_ROOT$/tsconfig.json"],
      "outputs": ["junit.xml"]
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"],
      "outputs": ["junit-e2e.xml"]
    },
    "types": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
    },
    "check": {
      "dependsOn": [
        "//#lint",
        "^build",
        "types",
        "test",
        "test:e2e",
        "//#types",
        "//#test:scripts",
        "//#docs:validate",
        "//#docs:broken-links",
        "//#ci:check-pack"
      ]
    },
    "//#ci:check-pack": {
      "inputs": [
        ".circleci/development/**",
        ".circleci/release/**",
        ".circleci/development.yml",
        ".circleci/release.yml"
      ]
    },
    "//#test:scripts": {
      "inputs": [
        "scripts/**",
        ".changeset/**",
        "bunfig.toml",
        "package.json",
        "packages/*/package.json",
        "packages/adapters/*/package.json",
        "packages/adapter/src/api-version.ts"
      ],
      "outputs": ["$TURBO_ROOT$/test-results/scripts-junit.xml"]
    },
    "//#types": {
      "inputs": ["scripts/**", "tsconfig.json", "packages/adapter/src/api-version.ts"]
    },
    "//#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!$TURBO_ROOT$/openspec/**",
        "!$TURBO_ROOT$/.circleci/**",
        "!$TURBO_ROOT$/.changeset/**",
        "!$TURBO_ROOT$/.opencode/**",
        "!$TURBO_ROOT$/.claude/**"
      ]
    },
    "//#docs:validate": {
      "inputs": ["docs/**"]
    },
    "//#docs:broken-links": {
      "inputs": ["docs/**"]
    }
  },
  "ui": "tui"
}
