{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["bun.lock"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/bunfig.toml"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/bunfig.toml"],
      "outputs": ["$TURBO_ROOT$/test-results/**"]
    },
    "types": {
      "dependsOn": []
    },
    "check": {
      "dependsOn": [
        "//#lint",
        "types",
        "test",
        "//#types",
        "//#test:scripts",
        "//#docs:validate",
        "//#docs:broken-links",
        "//#ci:check-pack"
      ]
    },
    "//#ci:check-pack": {
      "inputs": [
        ".circleci/development/**",
        ".circleci/release/**",
        ".circleci/development.yml",
        ".circleci/release.yml"
      ]
    },
    "//#test:scripts": {
      "inputs": ["scripts/**"]
    },
    "//#types": {
      "inputs": ["scripts/**", "tsconfig.json"]
    },
    "//#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!$TURBO_ROOT$/openspec/**",
        "!$TURBO_ROOT$/.circleci/**",
        "!$TURBO_ROOT$/.changeset/**",
        "!$TURBO_ROOT$/.opencode/**",
        "!$TURBO_ROOT$/.claude/**"
      ]
    },
    "//#docs:validate": {
      "inputs": ["docs/**"]
    },
    "//#docs:broken-links": {
      "inputs": ["docs/**"]
    }
  },
  "ui": "tui"
}
