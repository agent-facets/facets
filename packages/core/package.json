{
  "name": "@agent-facets/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/agent-facets/facets",
    "directory": "packages/core"
  },
  "version": "0.6.3",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "bun ../../scripts/prepack.ts",
    "postpack": "bun ../../scripts/postpack.ts",
    "types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@agent-facets/adapter": "workspace:*",
    "arktype": "2.2.0",
    "comment-json": "^5.0.0",
    "nanotar": "0.3.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false,
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      }
    }
  }
