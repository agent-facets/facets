{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Agent Facets",
  "description": "Modular, versioned bundles of skills, agents, commands, and MCP servers that extend AI coding assistants",
  "logo": {
    "dark": "/assets/logo-dark.svg",
    "light": "/assets/logo-light.svg",
    "href": "https://agentfacets.io/"
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.agentfacets.io",
      "description": "Modular, versioned bundles of skills, agents, commands, and MCP servers that extend AI coding assistants",
      "language": "en",
      "color-scheme": "light dark",
      "reply-to": "support@agentfacets.io",
      "og:description": "Modular, versioned bundles of skills, agents, commands, and MCP servers that extend AI coding assistants"
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "dark": "github-dark",
        "light": "github-light"
      }
    }
  },
  "fonts": {
    "family": "Geist",
    "source": "https://cdn.jsdelivr.net/npm/@fontsource-variable/geist@5/files/geist-latin-wght-normal.woff2",
    "format": "woff2"
  },
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#6D28D9",
    "light": "#A78BFA",
    "dark": "#4C1D95"
  },
  "background": {
    "color": {
      "light": "#f4f5f9",
      "dark": "#0a0a12"
    }
  },
  "favicon": "/assets/favicon.ico",
  "redirects": [
    {
      "source": "/cli/adapters/install",
      "destination": "/cli/adapters/add",
      "permanent": true
    },
    {
      "source": "/cli/upgrade",
      "destination": "/cli/update",
      "permanent": true
    },
    {
      "source": "/specification/commit",
      "destination": "/specification/install",
      "permanent": true
    },
    {
      "source": "/specification/planning",
      "destination": "/cli/add",
      "permanent": true
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book",
        "groups": [
          {
            "group": "Agent Facets",
            "icon": "box",
            "pages": ["index", "quickstart", "docs/learn/index", "private-facets"]
          },
          {
            "group": "Guides",
            "icon": "rocket",
            "pages": [
              "guides/setup",
              "guides/install-facets",
              "guides/create-your-first-facet",
              "guides/publish-a-facet",
              "guides/troubleshooting"
            ]
          },
          {
            "group": "Concepts",
            "icon": "book",
            "pages": [
              "docs/learn/skills",
              "docs/learn/commands",
              "docs/learn/agents",
              "docs/learn/mcp-servers",
              "docs/learn/adapters"
            ]
          },
          {
            "group": "Adapter Development",
            "icon": "wrench",
            "pages": ["guides/custom-adapters", "reference/adapter-sdk"]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "CLI Reference",
            "pages": ["cli/index", "cli/env"]
          },
          {
            "group": "Facet Management",
            "icon": "box",
            "pages": ["cli/install", "cli/add", "cli/remove", "cli/update", "cli/search", "cli/list"]
          },
          {
            "group": "Adapters",
            "icon": "wrench",
            "pages": ["cli/adapters/add", "cli/adapters/list", "cli/adapters/remove"]
          },
          {
            "group": "Authentication",
            "icon": "lock",
            "pages": ["cli/login", "cli/whoami", "cli/logout"]
          },
          {
            "group": "Authoring",
            "icon": "pencil",
            "pages": [
              "cli/authoring/create",
              "cli/authoring/edit",
              "cli/authoring/modify",
              "cli/authoring/build",
              "cli/authoring/publish"
            ]
          },
          {
            "group": "CLI",
            "icon": "terminal",
            "pages": ["cli/instructions", "cli/help", "cli/self-update"]
          }
        ]
      },
      {
        "tab": "Specification",
        "icon": "section",
        "groups": [
          {
            "group": "Overview",
            "pages": ["specification/index", "specification/terminology"]
          },
          {
            "group": "Project State",
            "pages": ["specification/project-manifest", "specification/lockfile"]
          },
          {
            "group": "Facet Artifact",
            "pages": ["specification/manifest", "specification/archive", "specification/integrity"]
          },
          {
            "group": "Installation",
            "pages": ["specification/install", "specification/materialization"]
          },
          {
            "group": "Authoring",
            "pages": ["specification/build", "specification/publish"]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "clock",
        "pages": ["changelog/index"]
      },
      {
        "tab": "Roadmap",
        "icon": "map",
        "groups": [
          {
            "group": "Roadmap",
            "root": "roadmap/index",
            "pages": ["roadmap/alpha", "roadmap/beta", "roadmap/stable"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "button",
        "icon": "download",
        "label": "Download CLI",
        "href": "/quickstart"
      },
      {
        "type": "button",
        "icon": "search",
        "label": "Search Facets",
        "href": "https://agentfacets.io/"
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/agent-facets/facets",
      "x": "https://x.com/FacetCafe",
      "discord": "https://discord.gg/qXQYaYna5w"
    }
  }
}
