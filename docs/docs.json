{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Agent Facets",
  "description": "A package manager for AI assistant extensions — skills, agents, commands, and MCP servers.",
  "logo": {
    "dark": "/assets/logo.svg",
    "light": "/assets/logo-light.svg",
    "href": "https://agentfacets.io/"
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "dark": "github-dark",
        "light": "github-light"
      }
    }
  },
  "fonts": {
    "family": "Arimo Sans, sans-serif"
  },
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#6D28D9",
    "light": "#A78BFA",
    "dark": "#4C1D95"
  },
  "favicon": "/assets/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book",
        "groups": [
          {
            "group": "Agent Facets",
            "icon": "/assets/icon.svg",
            "pages": ["index", "docs/learn/index"]
          },
          {
            "group": "Asset Types",
            "icon": "book",
            "pages": ["docs/learn/skills", "docs/learn/commands", "docs/learn/agents", "docs/learn/servers"]
          },
          {
            "group": "Contributing",
            "icon": "handshake",
            "pages": [
              "docs/contributing/getting-started",
              "docs/contributing/release-pipeline",
              "docs/contributing/ci-architecture",
              "docs/contributing/publishing"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "General",
            "pages": ["cli/index", "cli/env"]
          },
          {
            "group": "Facet Management",
            "icon": "box",
            "pages": ["cli/install", "cli/add", "cli/remove", "cli/update"]
          },
          {
            "group": "Adapters",
            "icon": "wrench",
            "pages": ["cli/adapters/install", "cli/adapters/list", "cli/adapters/remove"]
          },
          {
            "group": "Authoring",
            "icon": "pencil",
            "pages": ["cli/authoring/create", "cli/authoring/edit", "cli/authoring/build"]
          }
        ]
      },
      {
        "tab": "Specification",
        "icon": "section",
        "groups": [
          {
            "group": "Specification",
            "pages": ["specification/index"]
          },
          {
            "group": "Sections",
            "icon": "section",
            "pages": [
              "specification/terminology",
              "specification/architecture",
              "specification/manifest",
              "specification/publish",
              "specification/install",
              "specification/integrity",
              "specification/servers"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "clock",
        "pages": ["changelog/index"]
      },
      {
        "tab": "Roadmap",
        "icon": "map",
        "pages": ["roadmap/index", "roadmap/alpha", "roadmap/beta", "roadmap/stable"]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Search Facets",
      "href": "https://facet.cafe/"
    },
    "links": [
      {
        "type": "button",
        "icon": "download",
        "label": "Download CLI",
        "href": "https://agentfacets.io/install"
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/agent-facets/facets",
      "x": "https://x.com/FacetCafe",
      "discord": "https://discord.gg/qXQYaYna5w"
    }
  }
}
