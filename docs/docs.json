{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Agent Facets",
  "description": "Modular, versioned bundles of skills, agents, and commands that extend AI coding assistants",
  "logo": {
    "dark": "/assets/logo-dark.svg",
    "light": "/assets/logo-light.svg",
    "href": "https://agentfacets.io/"
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.agentfacets.io",
      "description": "Modular, versioned bundles of skills, agents, and commands that extend AI coding assistants",
      "language": "en",
      "color-scheme": "light dark",
      "reply-to": "support@agentfacets.io",
      "og:description": "Modular, versioned bundles of skills, agents, and commands that extend AI coding assistants"
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "dark": "github-dark",
        "light": "github-light"
      }
    }
  },
  "fonts": {
    "family": "Geist",
    "source": "https://cdn.jsdelivr.net/npm/@fontsource-variable/geist@5/files/geist-latin-wght-normal.woff2",
    "format": "woff2"
  },
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#6D28D9",
    "light": "#A78BFA",
    "dark": "#4C1D95"
  },
  "favicon": "/assets/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book",
        "groups": [
          {
            "group": "Agent Facets",
            "icon": "box",
            "pages": ["index", "quickstart", "docs/learn/index"]
          },
          {
            "group": "Guides",
            "icon": "rocket",
            "pages": [
              "guides/setup",
              "guides/install-facets",
              "guides/create-your-first-facet",
              "guides/publish-a-facet",
              "guides/custom-adapters",
              "guides/troubleshooting"
            ]
          },
          {
            "group": "Asset Types",
            "icon": "book",
            "pages": ["docs/learn/skills", "docs/learn/commands", "docs/learn/agents"]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "CLI Reference",
            "pages": ["cli/index", "cli/env"]
          },
          {
            "group": "Facet Management",
            "icon": "box",
            "pages": ["cli/install", "cli/add", "cli/remove", "cli/upgrade", "cli/search", "cli/list"]
          },
          {
            "group": "Adapters",
            "icon": "wrench",
            "pages": ["cli/adapters/install", "cli/adapters/list", "cli/adapters/remove"]
          },
          {
            "group": "Authentication",
            "icon": "lock",
            "pages": ["cli/login", "cli/whoami", "cli/logout"]
          },
          {
            "group": "Authoring",
            "icon": "pencil",
            "pages": [
              "cli/authoring/create",
              "cli/authoring/edit",
              "cli/authoring/modify",
              "cli/authoring/build",
              "cli/authoring/publish"
            ]
          },
          {
            "group": "CLI",
            "icon": "terminal",
            "pages": ["cli/instructions", "cli/help", "cli/self-update"]
          }
        ]
      },
      {
        "tab": "Specification",
        "icon": "section",
        "groups": [
          {
            "group": "Specification",
            "pages": [
              "specification/index",
              "specification/project-manifest",
              "specification/lockfile",
              "specification/manifest",
              "specification/archive",
              "specification/integrity"
            ]
          },
          {
            "group": "Installation",
            "pages": ["specification/install", "specification/planning", "specification/commit"]
          },
          {
            "group": "Authoring",
            "pages": ["specification/build", "specification/publish"]
          },
          {
            "group": "Reference",
            "pages": ["specification/terminology"]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "clock",
        "pages": ["changelog/index"]
      },
      {
        "tab": "Roadmap",
        "icon": "map",
        "pages": ["roadmap/index", "roadmap/alpha", "roadmap/beta", "roadmap/stable"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "button",
        "icon": "download",
        "label": "Download CLI",
        "href": "https://agentfacets.io/install"
      },
      {
        "type": "button",
        "icon": "search",
        "label": "Search Facets",
        "href": "https://agentfacets.io/"
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/agent-facets/facets",
      "x": "https://x.com/FacetCafe",
      "discord": "https://discord.gg/qXQYaYna5w"
    }
  }
}
